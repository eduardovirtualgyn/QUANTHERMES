# ==============================================================================
# QUANT HERMES — MODELO DE CONFIGURAÇÃO DE AMBIENTE DE PRODUÇÃO (.env.production)
# Regra Inviolável 9: NUNCA versionar credenciais reais ou senhas no Git.
# ==============================================================================

# Ambiente Operacional
HERMES_ENV=production
HERMES_LOG_LEVEL=INFO
HERMES_TIMEZONE=UTC

# Tokens de Segurança e Operador
# Token seguro (mínimo 16 caracteres) para desarme do Kill Switch e operações de auditoria
HERMES_OPERATOR_TOKEN=HERMES_RISK_OVERRIDE_PROD_REPLACE_ME_2026

# Gateway MT5 (Topologia Dual-Node)
# URL do microserviço Gateway Windows e token de autenticação mútua
HERMES_GATEWAY_URL=http://127.0.0.1:8001
HERMES_GATEWAY_TOKEN=HERMES_GATEWAY_SECRET_TOKEN_PROD_REPLACE_ME

# Configuração da Conta MetaTrader 5 (utilizado apenas no nó Windows MT5 Gateway)
MT5_LOGIN=0
MT5_PASSWORD=REPLACE_WITH_BROKER_PASSWORD
MT5_SERVER=HermesDemo-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Portas de Escuta
HERMES_DASHBOARD_PORT=8000
HERMES_GATEWAY_PORT=8001

