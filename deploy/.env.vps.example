# ==============================================================================
# QUANT HERMES — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO VPS)
# Copie este arquivo para .env no nó Linux: cp deploy/.env.vps.example .env
# ==============================================================================

# Ambiente e Nível de Log
HERMES_ENV=production
LOG_LEVEL=INFO

# Bind do Dashboard e Telemetria (Recomenda-se 127.0.0.1 com Reverse Proxy Caddy/Nginx)
MONITORING_BIND_IP=127.0.0.1
MONITORING_PORT=8000

# Token Institucional para Desarme do Kill Switch (Altere para um segredo forte em produção)
HERMES_OPERATOR_TOKEN=HERMES_RISK_OVERRIDE_SECURE_2026_PROD

# Token de Comunicação da Ponte entre o Nó Linux e o MT5 Gateway Windows
HERMES_BRIDGE_TOKEN=HERMES_BRIDGE_SECRET_KEY_PROD_9948271

# URL do Gateway MT5 no nó Windows (ou IP interno via WireGuard VPN)
MT5_GATEWAY_URL=http://10.0.0.2:8001

# Parâmetros de Risco e Segurança (Valores máximos invioláveis respeitados no código)
DEFAULT_RISK_PER_TRADE_PCT=0.25
MAX_RISK_PER_TRADE_HARD_CAP_PCT=0.50
MAX_AGGREGATE_RISK_PCT=1.00
MAX_DAILY_LOSS_PCT=1.50
MAX_WEEKLY_LOSS_PCT=3.00
MAX_DRAWDOWN_LIMIT_PCT=8.00
REQUIRE_MANDATORY_STOP_LOSS=true
