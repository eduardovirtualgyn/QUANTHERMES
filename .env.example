# ==============================================================================
# QUANT HERMES — ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO (.env.example)
# COPIE ESTE ARQUIVO PARA .env E PREENCHA SUAS CREDENCIAIS LOCAIS
# NUNCA COMMITE O ARQUIVO .env NO GIT OU EXIBE-O EM LOGS PÚBLICOS
# ==============================================================================

# AMBIENTE OPERACIONAL
HERMES_ENV=development # development | paper_trading | live_demo
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# METATRADER 5 (WINDOWS)
MT5_PATH=C:\Program Files\RoboForex MT5 Terminal\terminal64.exe
MT5_LOGIN=00000000
MT5_PASSWORD=sua_senha_demo_aqui
MT5_SERVER=RoboForex-Demo
MT5_TIMEOUT_MS=15000
MT5_PORTABLE=false

# REDIS & MENSAJERIA (LOCAL)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# BANCO DE DADOS RELACIONAL (POSTGRESQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=quant_hermes
POSTGRES_USER=hermes_admin
POSTGRES_PASSWORD=hermes_local_pass

# FASTAPI & DASHBOARD INTERNO
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=chave_secreta_jwt_de_desenvolvimento_trocar_em_producao

# PROVEDORES DE LLM (OPCIONAIS — APENAS PARA PESQUISA ADVERSARIAL ASSÍNCRONA)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

